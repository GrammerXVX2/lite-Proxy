# Base fallback URL (used if model-specific base_url is missing)
VLLM_BASE_URL=http://10.77.170.200:8000/v1

# Single source of truth for model names used in compose + JSON routing.
MODEL_EMBED=qwen-embed-4b-tei
MODEL_RERANK=qwen3-reranker-4b
MODEL_CHAT=qwen35-122b-a10b-fp8
MODEL_CHAT_V2=mimo-v2.5

# Default aliases used when request body does not pass model
DEFAULT_EMBED_MODEL=qwen-embed-4b-tei
DEFAULT_RERANK_MODEL=qwen3-reranker-4b
DEFAULT_CHAT_MODEL=qwen35-122b-a10b-fp8
DEFAULT_CHAT_MODEL_V2=mimo-v2.5

# Model routing for liteProxy (DB-free) from external JSON file.
# You can switch 127.0.0.1 to 0.0.0.0 in models.json if needed.
LITE_MODEL_CONFIG_FILE=models.json

UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_RETRY_ATTEMPTS=2
UPSTREAM_RETRY_STATUS_CODES=502,503,504
